{
  "name": "limitless-vscode",
  "displayName": "Limitless",
  "description": "Practical VS Code companion for Limitless with project-aware launch behavior and a real Control Center.",
  "version": "0.2.0",
  "publisher": "devnull-bootloader",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:limitless.start",
    "onCommand:limitless.startInWorkspaceRoot",
    "onCommand:limitless.openDocs",
    "onCommand:limitless.openSetupDocs",
    "onCommand:limitless.openWorkspaceProfile",
    "onCommand:limitless.openControlCenter",
    "onCommand:limitless.newChat",
    "onCommand:limitless.openChat",
    "onCommand:limitless.resumeSession",
    "onCommand:limitless.abortChat",
    "onView:limitless.controlCenter",
    "onView:limitless.chat"
  ],
  "main": "./src/extension.js",
  "files": [
    "README.md",
    "media/**",
    "src/extension.js",
    "src/presentation.js",
    "src/state.js",
    "src/chat/**",
    "themes/**"
  ],
  "contributes": {
    "commands": [
      {
        "command": "limitless.start",
        "title": "Limitless: Launch in Terminal",
        "category": "Limitless"
      },
      {
        "command": "limitless.startInWorkspaceRoot",
        "title": "Limitless: Launch in Workspace Root",
        "category": "Limitless"
      },
      {
        "command": "limitless.openDocs",
        "title": "Limitless: Open Repository",
        "category": "Limitless"
      },
      {
        "command": "limitless.openSetupDocs",
        "title": "Limitless: Open Setup Guide",
        "category": "Limitless"
      },
      {
        "command": "limitless.openWorkspaceProfile",
        "title": "Limitless: Open Workspace Profile",
        "category": "Limitless"
      },
      {
        "command": "limitless.openControlCenter",
        "title": "Limitless: Open Control Center",
        "category": "Limitless"
      },
      {
        "command": "limitless.newChat",
        "title": "Limitless: New Chat",
        "category": "Limitless"
      },
      {
        "command": "limitless.openChat",
        "title": "Limitless: Open Chat Panel",
        "category": "Limitless"
      },
      {
        "command": "limitless.resumeSession",
        "title": "Limitless: Resume Session",
        "category": "Limitless"
      },
      {
        "command": "limitless.abortChat",
        "title": "Limitless: Abort Generation",
        "category": "Limitless"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "limitless",
          "title": "Limitless",
          "icon": "media/limitless.svg"
        }
      ]
    },
    "views": {
      "limitless": [
        {
          "id": "limitless.chat",
          "name": "Chat",
          "type": "webview"
        },
        {
          "id": "limitless.controlCenter",
          "name": "Control Center",
          "type": "webview"
        }
      ]
    },
    "keybindings": [
      {
        "command": "limitless.openChat",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l"
      }
    ],
    "configuration": {
      "title": "Limitless",
      "properties": {
        "limitless.launchCommand": {
          "type": "string",
          "default": "limitless",
          "description": "Command run in the integrated terminal when launching Limitless."
        },
        "limitless.terminalName": {
          "type": "string",
          "default": "Limitless",
          "description": "Integrated terminal tab name for Limitless sessions."
        },
        "limitless.useOpenAIShim": {
          "type": "boolean",
          "default": false,
          "description": "Optionally set CLAUDE_CODE_USE_OPENAI=1 in launched Limitless terminals."
        },
        "limitless.permissionMode": {
          "type": "string",
          "default": "acceptEdits",
          "enum": ["default", "acceptEdits", "bypassPermissions", "plan"],
          "enumDescriptions": [
            "Prompt for permission on each tool use (requires manual approval)",
            "Auto-approve file edits, prompt for other operations (recommended)",
            "Auto-approve all operations without prompting",
            "Read-only mode — no file modifications allowed"
          ],
          "description": "Permission mode for chat sessions. Controls which tool operations are auto-approved."
        }
      }
    },
    "themes": [
      {
        "label": "Limitless Terminal Black",
        "uiTheme": "vs-dark",
        "path": "./themes/Limitless-Terminal-Black.json"
      }
    ]
  },
  "scripts": {
    "test": "node --test ./src/*.test.js",
    "lint": "node scripts/lint.js",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "keywords": [
    "limitless",
    "terminal",
    "theme",
    "cli",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/verickwayne/limitless"
  },
  "license": "MIT"
}
